# ---------------------------------------------------------------------------
# AB IT Tech Portfolio - environment template.
# Copy to `.env` (never commit it):   cp .env.example .env
# Every value below is a PLACEHOLDER. Replace the secrets before real use.
# ---------------------------------------------------------------------------

# --- Django -----------------------------------------------------------------
# Generate: python -c "from django.core.management.utils import get_random_secret_key as g; print(g())"
DJANGO_SECRET_KEY=replace-with-a-long-random-string
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:3000
CSRF_TRUSTED_ORIGINS=http://localhost:3000
DJANGO_TIME_ZONE=UTC
LOG_LEVEL=INFO

# --- PostgreSQL -------------------------------------------------------------
POSTGRES_DB=ab_portfolio
POSTGRES_USER=ab_portfolio
POSTGRES_PASSWORD=replace-with-a-database-password
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# --- Media & uploads ----------------------------------------------------------
# Absolute URL used in API responses for uploaded files (must end with /).
MEDIA_BASE_URL=http://localhost:8000/media/
# Let Django serve /media/ (fine for development and small deployments; use nginx or S3 at scale).
SERVE_MEDIA=True
MAX_IMAGE_UPLOAD_MB=5
MAX_GALLERY_IMAGES_PER_PROJECT=20
MAX_GALLERY_FILES_PER_REQUEST=10

# --- Optional S3-compatible storage (production) ---------------------------
USE_S3=False
AWS_STORAGE_BUCKET_NAME=
AWS_S3_ENDPOINT_URL=
AWS_S3_REGION_NAME=
AWS_S3_CUSTOM_DOMAIN=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# --- Auth & rate limits ---------------------------------------------------------
JWT_ACCESS_MINUTES=15
JWT_REFRESH_DAYS=7
THROTTLE_ANON=120/min
THROTTLE_USER=600/min
THROTTLE_LOGIN=10/min
THROTTLE_UPLOAD=60/min

# --- Production hardening (only when DJANGO_DEBUG=False) -------------------
# BEHIND_PROXY=True            # trust X-Forwarded-Proto from your reverse proxy
# NUM_PROXIES=1                # for correct client IPs in rate limiting
# SECURE_SSL_REDIRECT=True

# --- Optional: bootstrap the first admin automatically in Docker -----------
# ADMIN_USERNAME=
# ADMIN_EMAIL=
# ADMIN_PASSWORD=

# --- Frontend build values used by docker-compose ------------------------------
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api/v1
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_COMPANY_NAME=AB IT Tech Solution
NEXT_PUBLIC_CONTACT_EMAIL=
NEXT_PUBLIC_CONTACT_PHONE=
NEXT_PUBLIC_CONTACT_ADDRESS=
