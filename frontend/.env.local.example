# Copy to frontend/.env.local for local development (never commit .env.local).
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api/v1
# Optional: used by server-side rendering when the backend is reachable on a different (internal) address, e.g. in Docker.
# API_INTERNAL_BASE_URL=http://backend:8000/api/v1
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_COMPANY_NAME="AB IT Tech Solution"
# Optional public contact details. Leave empty to hide them; nothing is invented.
NEXT_PUBLIC_CONTACT_EMAIL=
NEXT_PUBLIC_CONTACT_PHONE=
NEXT_PUBLIC_CONTACT_ADDRESS=
